{
  "action": {
    "default_icon": {
      "128": "icon128.png",
      "16": "icon16.png",
      "19": "icon19.png",
      "38": "icon38.png",
      "48": "icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [ "content.js" ],
      "matches": [
        "https://chat.openai.com/*",
        "https://openai.com/*",
        "*://*.openai.com/*",
        "*://*.chatgpt.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "GPT Queue Enterprise Edition - Unlimited message queues, prompt chains, and batch jobs for ChatGPT.",
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "19": "icon19.png",
    "38": "icon38.png",
    "48": "icon48.png"
  },
  "manifest_version": 3,
  "name": "GPT Queue Enterprise Edition",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "version": "1.0.0"
}
