{
   "action": {
      "default_icon": {
         "128": "public/icon128.png",
         "16": "public/icon16.png",
         "48": "public/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "i18n.js", "content.js" ],
      "matches": [ "*://*.instagram.com/*" ]
   } ],
   "description": "Automate Instagram follows and likes for commenters on a post.",
   "host_permissions": [ "*://*.instagram.com/*", "https://falconbot.duckdns.org/*" ],
   "icons": {
      "128": "public/icon128.png",
      "16": "public/icon16.png",
      "48": "public/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "IG Auto-Follow & Like from Post Comments",
   "permissions": [ "storage", "tabs", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.5",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "monetization.js" ]
   } ]
}
